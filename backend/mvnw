#!/usr/bin/env sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BUNDLED_MVN="$SCRIPT_DIR/../tools/apache-maven-3.9.9/bin/mvn"

if [ -x "$BUNDLED_MVN" ]; then
  exec "$BUNDLED_MVN" "$@"
fi

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if command -v docker >/dev/null 2>&1; then
  exec docker run --rm -v "$(pwd):/workspace" -w /workspace maven:3.9.9-eclipse-temurin-17 mvn "$@"
fi

echo "Maven n'est pas installe et Docker n'est pas disponible."
echo "Installez Maven 3.9+ ou Docker pour executer le build."
exit 1
